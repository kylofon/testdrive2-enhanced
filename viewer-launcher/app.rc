// app.rc -- Windows resources: icon, manifest, version info, and wxWidgets' own.
#include <winresrc.h>

#include "version.h"

// Explorer shows the alphabetically first icon.
aaaa ICON "app.ico"

// Our manifest asks for Common Controls 6 and DPI awareness itself.
#define wxUSE_NO_MANIFEST 1
#include "wx/msw/wx.rc"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "TD2 Map Viewer"
      VALUE "ProductName", "TD2 Map Viewer"
      VALUE "FileVersion", APP_VERSION_TEXT
      VALUE "ProductVersion", APP_VERSION_TEXT
      VALUE "CompanyName", "Krzysztof Kania"
      VALUE "InternalName", "TD2 Map Viewer"
      VALUE "OriginalFilename", "TD2 Map Viewer.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
